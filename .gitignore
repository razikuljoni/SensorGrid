# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# SQLite & databases
db/*.db
db/*.db-journal
*.db
*.sqlite
*.sqlite-journal

# Code graph & tools
.codegraph/
tool-results/

# Orchestration / session state
.omo/

# Lockfiles — pnpm is the preferred package manager (source of truth).
# Keep pnpm-lock.yaml tracked; ignore alternates (bun/npm/yarn) so multiple
# package managers never fight over the dependency graph on one machine.
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Local run artifacts
dev.log
dev.out.log
realtime.log
*.pid
